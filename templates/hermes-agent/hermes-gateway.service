[Unit]
Description=Hermes Agent Gateway - API Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.hermes-venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=%h/.hermes-venv/lib/python3.13/site-packages
Environment=PATH=%h/.hermes-venv/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VIRTUAL_ENV=%h/.hermes-venv
Environment=HERMES_HOME=%h/.hermes
EnvironmentFile=-%h/.hermes/.env
Restart=on-failure
RestartSec=10
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target