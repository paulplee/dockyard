# Secrets — mounted read-only from $VOLUMES_BASE/secrets/env inside the container.
#
# Copy this file to 'env' and fill in your values:
#
#   cp /path/to/secrets/env.example /path/to/secrets/env
#
# IMPORTANT: never commit this file with real credentials.

# ---------------------------------------------------------------------------
# LiteLLM master key — all API clients must send this as the Bearer token.
# Generate a secure key: openssl rand -hex 32
# ---------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-changeme

# ---------------------------------------------------------------------------
# Upstream provider API keys — only set the providers you use.
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=AIza...

# Groq
GROQ_API_KEY=gsk_...

# ---------------------------------------------------------------------------
# Optional — additional providers (uncomment as needed)
# ---------------------------------------------------------------------------
# COHERE_API_KEY=...
# MISTRAL_API_KEY=...
# TOGETHER_API_KEY=...
# PERPLEXITY_API_KEY=...
